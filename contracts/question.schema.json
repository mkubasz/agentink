{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentink.local/contracts/question.schema.json",
  "title": "Question",
  "description": "What an agent hands to `ink ask` (and the `data` of QuestionAsked). One question, one page.",
  "type": "object",
  "required": ["kind", "title"],
  "additionalProperties": false,
  "properties": {
    "kind": { "enum": ["decision", "critique", "escalation", "stamp", "proposals", "brief", "summary"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "body": { "type": "string", "maxLength": 20000, "description": "Markdown shown under the title." },
    "critical": { "type": "boolean", "default": false, "description": "Payment, deploy, anything irreversible: answered only from a stamp zone." },
    "spec": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "anchor": { "type": "string", "pattern": "^Q[0-9]{1,3}$", "description": "The `### Q<n>.` heading the answer goes to." }
      }
    },
    "options": {
      "type": "array", "minItems": 2, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[A-D]$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "recommended": { "type": "boolean" },
          "why": { "type": "string", "maxLength": 2000 },
          "cost": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "items": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "description": "Findings (critique) or proposed actions (proposals), one check zone each.",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][0-9]{1,3}$" },
          "severity": { "enum": ["blocks", "should", "note"] },
          "where": { "type": "string", "maxLength": 300 },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "orchestrator": { "enum": ["herdr", "rex", "headless", "none"] },
        "herdr": {
          "type": "object", "additionalProperties": false,
          "properties": { "pane_id": { "type": "string" }, "workspace_id": { "type": "string" }, "tab_id": { "type": "string" } }
        },
        "rex": {
          "type": "object", "additionalProperties": false,
          "properties": { "session": { "type": "string" }, "block": { "type": "string" }, "server": { "type": "string" } }
        },
        "headless": {
          "type": "object", "additionalProperties": false,
          "properties": { "program": { "enum": ["claude", "pi"] }, "session_id": { "type": "string" }, "cwd": { "type": "string" } }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "decision" } } }, "then": { "required": ["options"] } },
    { "if": { "properties": { "kind": { "enum": ["critique", "proposals"] } } }, "then": { "required": ["items"] } }
  ]
}
