{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentink.local/contracts/page.schema.json",
  "title": "Page",
  "description": "page.json: one render of one question revision (ADR 0005). The worker reads it to know the fields; the QR payload names the page.",
  "type": "object",
  "required": ["id", "rev", "question_id", "question_rev", "kind", "title", "device", "fields", "qr", "rendered_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/ulid" },
    "rev": { "type": "integer", "minimum": 1 },
    "question_id": { "$ref": "#/$defs/ulid" },
    "question_rev": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["decision", "critique", "escalation", "stamp", "proposals", "brief", "summary", "inbox", "confirmation"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "device": {
      "type": "object",
      "required": ["profile", "width_px", "height_px", "format"],
      "additionalProperties": false,
      "properties": {
        "profile": { "type": "string", "minLength": 1 },
        "width_px": { "type": "integer", "minimum": 600 },
        "height_px": { "type": "integer", "minimum": 600 },
        "format": { "enum": ["pdf", "png"] }
      }
    },
    "fields": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "label"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
          "kind": { "enum": ["choice", "check", "text", "sketch", "stamp"] },
          "label": { "type": "string", "maxLength": 300 },
          "options": {
            "type": "array",
            "items": { "type": "object", "required": ["key", "label"], "additionalProperties": false,
              "properties": { "key": { "type": "string", "pattern": "^[A-D]$|^(yes|no|ok|fail|try|skip|stop)$" }, "label": { "type": "string" } } }
          },
          "required": { "type": "boolean" }
        }
      }
    },
    "qr": {
      "type": "object",
      "required": ["payload"],
      "additionalProperties": false,
      "properties": { "payload": { "type": "string", "pattern": "^INK:[0-9A-HJKMNP-TV-Z]{26}:[0-9]+$" } }
    },
    "rendered_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" }
  },
  "$defs": { "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" } }
}
