{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkhub.local/contracts/ocr.schema.json",
  "title": "OCR result",
  "description": "ocr.json: what the worker recognized per field, with its confidence and the crop it read (ADR 0007). Raw engine output stays here and never reaches the spec file.",
  "type": "object",
  "required": ["page_id", "rev", "engine", "fields"],
  "additionalProperties": false,
  "properties": {
    "page_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "rev": { "type": "integer", "minimum": 1 },
    "engine": {
      "type": "object", "required": ["name", "version"], "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
    },
    "alignment": {
      "type": "object", "additionalProperties": false,
      "properties": { "ok": { "type": "boolean" }, "qr_payload": { "type": "string" }, "residual_px": { "type": "number", "minimum": 0 } }
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "value", "confidence"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["choice", "check", "text", "sketch", "stamp"] },
          "value": { "type": ["string", "boolean", "null"] },
          "raw": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "crop": { "type": "string", "description": "Path of the crop PNG, relative to the page directory." },
          "strokes": { "type": "string", "description": "Path of the strokes JSON, relative to the page directory." },
          "ink_ratio": { "type": "number", "minimum": 0, "maximum": 1, "description": "Dark-pixel share of a check zone." }
        }
      }
    }
  }
}
