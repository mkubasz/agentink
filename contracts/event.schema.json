{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentink.local/contracts/event.schema.json",
  "title": "Event envelope",
  "description": "One line of a project's events.jsonl (ADR 0005). `data` is validated per `type` by the slice that emits it.",
  "type": "object",
  "required": ["id", "type", "at", "project", "subject", "rev"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/ulid" },
    "type": {
      "enum": [
        "ProjectRegistered", "DeviceAdded", "DeviceRevoked",
        "QuestionAsked", "QuestionWithdrawn",
        "PageRendered", "RenderFailed", "PagePublished",
        "InkReceived", "IngestRejected",
        "AnswerRecognized", "RecognitionFailed", "ConfirmationRequested",
        "AnswerConfirmed", "AnswerRejected",
        "AnswerDelivered", "DeliveryFailed",
        "SpecChanged", "AgentBlocked"
      ]
    },
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "project": { "$ref": "#/$defs/slug" },
    "subject": { "type": "string", "pattern": "^(project|question|page|device|delivery|spec)/[A-Za-z0-9._/-]{1,200}$" },
    "rev": { "type": "integer", "minimum": 0 },
    "data": { "type": "object" },
    "causation_id": { "$ref": "#/$defs/ulid" },
    "correlation_id": { "$ref": "#/$defs/ulid" }
  },
  "$defs": {
    "ulid": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
  }
}
